{
    "name": "gokure/hyperf-http-logger",
    "description": "Log HTTP requests and responses for Hyperf.",
    "keywords": ["hyperf", "logger", "http-logger", "request", "request-logger"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Gang Wu",
            "email": "gokure@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "hyperf/di": "~3.2.0",
        "hyperf/http-server": "~3.2.0",
        "hyperf/logger": "~3.2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.6",
        "hyperf/testing": "~3.2.0",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "Gokure\\HttpLogger\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.2-dev"
        },
        "hyperf": {
            "config": "Gokure\\HttpLogger\\ConfigProvider"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "./vendor/bin/co-phpunit --colors=always",
        "cs-fix": "./vendor/bin/php-cs-fixer fix $1",
        "analyse": "phpstan analyse --memory-limit 300M -l 0 -c phpstan.neon ./src ./tests"
    }
}
